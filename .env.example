# Configurações do Sistema de Coleta de Dados
# Copie este arquivo para .env e configure as variáveis

# Ambiente de execução
NODE_ENV=development

# Configurações do Web Scraper (Magazine Luiza)
MAGALU_BASE_URL=https://www.magazineluiza.com.br
SCRAPER_TIMEOUT=30000
SCRAPER_DELAY=2000

# Configurações da API INMET
INMET_API_URL=https://apitempo.inmet.gov.br
INMET_TIMEOUT=30000

# Configurações de saída
OUTPUT_DIR=dados-coletados
LOG_LEVEL=info

# Configurações do navegador (Puppeteer)
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=30000

# Configurações PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=coleta_dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Configurações MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=coleta_dados
